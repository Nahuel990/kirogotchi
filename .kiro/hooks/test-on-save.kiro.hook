{
  "enabled": true,
  "name": "Run tests when the quantum model or API changes",
  "description": "Any edit under app/ reruns the suite and asks the agent to fix regressions, keeping the closed-form check in sync with the circuit.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["app/**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `.venv/bin/python -m pytest -q -W ignore`. If anything fails, fix it. If app/quantum.py changed the circuit, update probability_alive_closed_form and .kiro/specs/kirogotchi/design.md so they still match, then rerun."
  }
}
